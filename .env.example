# Local PostgreSQL running through compose.yaml
DATABASE_URL="postgresql://taskharbor:taskharbor@localhost:5433/taskharbor?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-random-secret"

# Optional: uncomment to override the demo password while seeding
# SEED_USER_PASSWORD="use-a-strong-password-outside-local-development"
